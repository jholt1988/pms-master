# --- Core ---
NODE_ENV=production
PORT=3001

# --- Database ---
DATABASE_URL=postgresql://pms:pms@postgres:5432/pms?schema=public

# --- Security ---
JWT_SECRET=change-this-to-a-long-random-secret

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:3003,http://localhost:8000,http://localhost:3002
# --- Service URLs (internal docker network) ---
MIL_SERVICE_URL=http://mil:3010
WORKFLOW_ENGINE_URL=http://workflow-engine:3003
ML_SERVICE_URL=http://ml-service:8000

# --- MIL toggles ---
MIL_WRAPPER_ENABLED=true
MIL_ENCRYPT_AT_REST_ENABLED=false
MIL_AUDIT_PERSIST_ENABLED=false

# --- Frontend build ---
VITE_API_URL=/api