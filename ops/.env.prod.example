# Backend
# Supabase mode (recommended): use DIRECT Postgres connection for Prisma migrate deploy.
# Example format:
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres?schema=public
# SHADOW_DATABASE_URL can point to a separate DB or be omitted if not used in deploy flow.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME_SHADOW?schema=public
DIRECT_URL=
JWT_SECRET=replace-with-long-random-secret
ALLOWED_ORIGINS=https://app.example.com
PORT=3001
POSTGRES_DB=pms
POSTGRES_USER=pms
POSTGRES_PASSWORD=replace-with-strong-postgres-password
RABBITMQ_DEFAULT_USER=pms
RABBITMQ_DEFAULT_PASS=replace-with-strong-rabbitmq-password
BACKEND_IMAGE=ghcr.io/OWNER/REPO/backend
FRONTEND_IMAGE=ghcr.io/OWNER/REPO/frontend
KEYRING_OS_IMAGE=ghcr.io/OWNER/REPO/keyring-os
IMAGE_TAG=latest
VITE_API_URL=/api

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# MIL safe defaults
MIL_WRAPPER_ENABLED=false
MIL_ENCRYPT_AT_REST_ENABLED=false
MIL_AUDIT_PERSIST_ENABLED=false
