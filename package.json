{
  "name": "pms-master",
  "private": true,
  "scripts": {
    "property-os": "pnpm --filter property-os",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --filter tenant_portal_backend --filter tenant_portal_app dev",
    "dev:workspace": "pnpm -r dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "bg:workflow": "bash scripts/background-workflow.sh",
    "bg:workflow:quick": "bash scripts/background-workflow.sh --quick",
    "env:down": "docker compose down",
    "env:dev": "docker compose --env-file ops/.env.dev up -d --build",
    "env:dev:migrate": "docker compose --env-file ops/.env.dev run --rm --profile tools backend-migrate",
    "env:supabase": "docker compose --env-file ops/.env.supabase up -d --build",
    "env:supabase:migrate": "docker compose --env-file ops/.env.supabase run --rm --profile tools backend-migrate",
    "env:prod:config": "docker compose --env-file ops/.env.prod.example -f docker-compose.yml -f docker-compose.prod.yml config",
    "env:logs:backend": "docker compose logs --tail=150 backend",
    "env:logs:frontend": "docker compose logs --tail=150 frontend",
    "env:health": "docker compose exec frontend sh -lc \"wget -S -O- http://backend:3001/api/health | head -n 40\"",
    "contracts:core-routes": "node scripts/check-core-route-contracts.js",
    "contracts:openapi": "node scripts/check-openapi-contract-hardening.js",
    "ops:backup-restore:check": "node scripts/check-backup-restore-runbook.js",
    "ops:monitoring:check": "node scripts/check-monitoring-alerts.js",
    "load:phase5": "node scripts/phase5-load-baseline.mjs",
    "load:phase5:check": "node scripts/check-phase5-load-baseline.js",
    "security:deps:exceptions": "node scripts/check-dependency-audit-exceptions.js",
    "security:deps:audit": "pnpm audit --prod",
    "ci:phase1": "pnpm --filter @propertyos/api-contracts type-check && pnpm --filter tenant_portal_backend build && pnpm --filter tenant_portal_backend openapi:generate && pnpm contracts:openapi && pnpm --filter operator_app api:types && pnpm --filter tenant_portal_backend test:foundation && pnpm --filter tenant_portal_backend test:contracts:operator && pnpm --filter operator_app type-check && pnpm --filter operator_app build && pnpm --filter tenant_portal_backend seed:verify:phase1 && pnpm --filter tenant_portal_backend smoke:golden-path",
    "prepare": "husky",
    "lint:backend": "pnpm --filter tenant_portal_backend lint",
    "lint:backend:fix": "pnpm --filter tenant_portal_backend lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "pnpm --filter prisma run db:generate"
  },
  "dependencies": {
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/microservices": "^11.1.18",
    "@types/node": "^24.11.0",
    "amqp-connection-manager": "^4.1.15",
    "amqplib": "^0.10.9",
    "compression": "^1.8.0",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "husky": "^9.1.7"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "semi": true,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto"
  },
  "lint-staged": {
    "tenant_portal_backend/src/**/*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "tenant_portal_app/src/**/*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "lint-staged": "^15.2.0",
    "pnpm": "^8.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.0.4"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4"
    },
    "packageExtensions": {
      "@nestjs/event-emitter@*": {
        "peerDependencies": {
          "@nestjs/microservices": "*",
          "@nestjs/platform-express": "*"
        },
        "peerDependenciesMeta": {
          "@nestjs/microservices": {
            "optional": true
          },
          "@nestjs/platform-express": {
            "optional": true
          }
        }
      }
    }
  },
  "packageManager": "pnpm@8.15.8+sha512.d1a029e1a447ad90bc96cd58b0fad486d2993d531856396f7babf2d83eb1823bb83c5a3d0fc18f675b2d10321d49eb161fece36fe8134aa5823ecd215feed392"
}
