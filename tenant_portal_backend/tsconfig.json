{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "rootDir": "../",
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "paths": {
      "axios": [
        "./node_modules/axios"
      ]
    },
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "removeComments": true,
    "incremental": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": false,
    "useDefineForClassFields": false,
    "isolatedModules": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.spec.ts",
    "test/**",
    "src/quickbooks/**",
    "src/**/*-radial.controller.ts",
    "src/analytics/portfolio-analytics.controller.ts",
    "src/copilot/decision-engine.controller.ts",
    "src/documents/document-management.controller.ts",
    "src/lease/lease-lifecycle.controller.ts",
    "src/notifications/notification.controller.ts",
    "src/property/property-radial.controller.ts",
    "src/settings/organization-settings.controller.ts",
    "src/tenant/tenant-profile.controller.ts",
    "src/vendors/vendor-management.controller.ts",
    "src/webhooks/webhook.controller.ts"
  ]
}
