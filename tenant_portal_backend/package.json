{
  "name": "tenant_portal_backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "prebuild": "prisma generate",
    "pretest": "prisma generate",
    "dev": "ts-node --transpile-only src/index.ts",
    "start": "ts-node --transpile-only src/index.ts",
    "start:check": "ts-node --transpile-only src/index.ts",
    "seed:check": "ts-node scripts/check-seed-coverage.ts",
    "seed:missing": "ts-node scripts/seed-missing.ts",
    "seed:events": "ts-node scripts/seed-event-simulations.ts",
    "seed:load-test": "ts-node scripts/load-test-events.ts",
    "seed:inspection-demo": "ts-node scripts/dev-seed-inspection-demo.ts",
    "seed:inspection-demo:robust": "node scripts/seed-inspection-demo-robust.js",
    "seed:verify:demo": "ts-node scripts/verify-demo-seed.ts",
    "seed:verify:phase1": "ts-node scripts/verify-phase1-seed.ts",
    "ml:readiness": "ts-node scripts/ml-data-readiness-audit.ts",
    "ml:readiness:json": "ts-node scripts/ml-data-readiness-audit.ts --json",
    "ml:readiness:md": "ts-node scripts/ml-data-readiness-audit.ts --out reports/ml-data-readiness-latest.md",
    "ml:readiness:help": "ts-node scripts/ml-data-readiness-audit.ts --help",
    "ml:simulate:demo": "ts-node scripts/simulate-ml-demo.ts",
    "ml:seed:targeted": "ts-node scripts/seed-ml-targeted-readiness.ts",
    "ml:simulate:targeted": "npm run ml:seed:targeted && npm run ml:readiness:json && npm run ml:readiness:md",
    "build": "tsc",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:sit-master": "ts-node scripts/sit-master.ts",
    "db:seed:demo": "ts-node prisma/seed-demo.ts",
    "db:seed:mock": "ts-node prisma/seed-mock.ts",
    "db:seed:admin": "node prisma/seedAdmin.js",
    "db:seed:real-data": "node prisma/seed-real-data.js",
    "ledger:backfill": "ts-node scripts/backfill-operational-ledger.ts",
    "ledger:reconcile": "ts-node scripts/reconcile-lease-balances.ts",
    "ledger:reconcile:apply": "ts-node scripts/reconcile-lease-balances.ts --apply",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:unit:ci": "jest --config jest.config.js --selectProjects unit --runInBand --ci",
    "test:integration": "jest --config jest.config.js --selectProjects integration --passWithNoTests",
    "test:integration:ci": "jest --config jest.config.js --selectProjects integration --runInBand --ci --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --config jest.config.js --selectProjects unit --coverage --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand --testPathIgnorePatterns=test/(chatbot-rag|concurrent-operations|failure-scenarios)\\.e2e\\.spec\\.ts$",
    "test:e2e:critical": "jest --config test/jest-e2e.json --runInBand --testPathPatterns=test/(auth|payments|lease|leasing|application-lifecycle|tenant-feed)\\.e2e\\.spec\\.ts$",
    "test:e2e:quarantine": "jest --config test/jest-e2e.json --runInBand --testPathPatterns=test/(chatbot-rag|concurrent-operations|failure-scenarios)\\.e2e\\.spec\\.ts$",
    "test:e2e:coverage": "jest --config test/jest-e2e.json --runInBand --coverage",
    "test:e2e:property-os": "jest --config test/jest-e2e.json test/property-os-v16-e2e.spec.ts --runInBand",
    "test:quickbooks": "ts-node scripts/test-quickbooks-integration.ts",
    "test:quickbooks:interactive": "ts-node scripts/test-quickbooks-integration.ts --interactive",
    "check:esignature": "ts-node scripts/check-esignature-config.ts",
    "diagnose:esignature": "ts-node scripts/diagnose-esignature-config.ts",
    "test:endpoints": "ts-node scripts/test-endpoints.ts",
    "smoke:golden-path": "ts-node scripts/golden-path-smoke.ts",
    "test:property-os-contract": "jest test/property-os-v16-contract.spec.ts --runInBand",
    "test:parity:property-os": "jest test/property-os-v16-parity.spec.ts --runInBand",
    "test:contracts:operator": "npm run openapi:generate && jest --config jest.config.js --selectProjects unit --runTestsByPath test/operator-p0-contract.spec.ts test/openapi-contract-hardening.spec.ts --runInBand",
    "test:foundation": "jest --config jest.config.js --selectProjects unit --runTestsByPath src/foundation/foundation.contract.spec.ts --runInBand",
    "test:phase1:ci": "npm run build && npm run openapi:generate && npm run test:foundation && npm run test:contracts:operator && npm run seed:verify:phase1 && npm run smoke:golden-path",
    "openapi:generate": "ts-node --transpile-only scripts/generate-openapi.ts",
    "verify:integration": "node scripts/verify-integration-flow.mjs",
    "test:ci": "npm run lint && npm run test:unit:ci && npm run test:integration:ci && npm run test:e2e:critical",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.ts' --fix"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "plugin:@typescript-eslint/recommended"
    ],
    "root": true,
    "env": {
      "node": true,
      "jest": true
    },
    "ignorePatterns": [
      "dist/",
      "node_modules/",
      "prisma/"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "off",
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "@typescript-eslint/no-require-imports": "off",
      "no-console": "warn"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.9",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/microservices": "^11.1.9",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.2",
    "@propertyos/mil-client": "workspace:*",
    "@sentry/nestjs": "^10.25.0",
    "@sentry/node": "^10.25.0",
    "@sentry/opentelemetry": "^10.32.1",
    "@sentry/profiling-node": "^10.25.0",
    "@types/docusign-esign": "^5.19.9",
    "@types/nodemailer": "^7.0.3",
    "ajv": "^8.18.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "approve-builds": "^1.0.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "bullmq": "^5.73.1",
    "cache-manager": "^6.4.2",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-sanitizer": "^1.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "date-fns": "^4.1.0",
    "docusign-esign": "^8.5.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.10.0",
    "expr-eval": "^2.0.2",
    "express": "^5.1.0",
    "fastapi": "^0.0.8",
    "greenlock-express": "^4.0.3",
    "helmet": "^8.1.0",
    "intuit-oauth": "^4.2.2",
    "ioredis": "^5.8.2",
    "jwt-decode": "^4.0.0",
    "multer": "^2.0.2",
    "nest-winston": "^1.10.2",
    "node-quickbooks": "^2.0.46",
    "nodemailer": "^7.0.10",
    "openai": "^6.9.0",
    "opossum": "^9.0.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "pydantic": "0.0.1-security",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^19.3.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "uvicorn": "0.0.1-security",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@nestjs/testing": "^11.1.9",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jwt-decode": "^2.2.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "pg": "^8.18.0",
    "prisma": "6.19.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.4"
  }
}
