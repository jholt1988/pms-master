  /**
   * Send a message to tenant about their payment
   * Gap: Issue 1 - Payment Execution Handlers (P0)
   */
  async sendTenantMessage(
    paymentId: number,
    subject: string,
    message: string,
    actorId: string,
    orgId: string,
  ) {
    // Verify payment exists
    const payment = await this.prisma.payment.findUnique({
      where: { id: paymentId },
    });

    if (!payment) {
      throw new NotFoundException(`Payment ${paymentId} not found`);
    }

    // Log message (in production would send email)
    this.logger.log(`Payment ${paymentId}: Tenant message queued - Subject: ${subject}`);

    return {
      success: true,
      paymentId,
      message: 'Message queued for tenant',
      subject,
    };
  }

  /**
   * Record a manual payment for an existing payment
   * Gap: Issue 1 - Payment Execution Handlers (P0)
   */
  async recordManualPayment(
    paymentId: number,
    amount: number,
    paymentDate: Date,
    notes: string | undefined,
    paymentMethod: string,
    actorId: string,
    orgId: string,
  ) {
    // Verify payment exists
    const payment = await this.prisma.payment.findUnique({
      where: { id: paymentId },
    });

    if (!payment) {
      throw new NotFoundException(`Payment ${paymentId} not found`);
    }

    // Log manual payment (full implementation would update status)
    this.logger.log(`Payment ${paymentId}: Manual payment recorded - amount: ${amount}, method: ${paymentMethod}`);

    return {
      success: true,
      paymentId,
      previousStatus: payment.status,
      newStatus: payment.status,
      amountPaid: amount,
    };
  }

