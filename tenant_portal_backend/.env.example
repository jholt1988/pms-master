# tenant_portal_backend environment configuration
#
# Copy this file to `.env` and fill in the values. Every variable is validated
# on boot by src/config/env/env.validation.ts (Zod) — the app refuses to start
# if a REQUIRED var is missing. Values shown below are the schema defaults where
# one exists; secrets are intentionally left blank.
#
# NEVER commit a filled-in `.env` (it is gitignored). Load real secrets from a
# secret manager in production.

# --- Core ---
NODE_ENV=development                    # development | production | test
PORT=3001

# --- Database (REQUIRED) ---
DATABASE_URL=postgresql://user:password@localhost:5432/tenant_portal

# --- JWT (REQUIRED; use >= 32 chars in production) ---
JWT_SECRET=change-me-at-least-8-characters
JWT_EXPIRATION=24h

# --- Redis ---
# REDIS_URL=redis://localhost:6379     # optional; overrides host/port when set
REDIS_HOST=redis
REDIS_PORT=6379

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Email / SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- AI services ---
AI_ENABLED=false
AI_PROVIDER=openai                     # openai | anthropic | lightning
AI_CHATBOT_ENABLED=false
AI_PROPERTY_OPS_ORCHESTRATOR_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LIGHTNING_API_KEY=
LIGHTNING_MODEL=lightning-ai/DeepSeek-V4-Pro-normalize

# --- Stripe (optional; payments disabled if unset) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Sentry (optional; error tracking) ---
SENTRY_DSN=

# --- eSignature (optional) ---
ESIGN_PROVIDER=
ESIGN_STRICT_MODE=true
ESIGN_PROVIDER_BASE_URL=
ESIGN_PROVIDER_API_KEY=
ESIGN_PROVIDER_CLIENT_ID=
ESIGN_PROVIDER_ACCOUNT_ID=
# Never commit a real private key — load it from a secret manager.
ESIGN_PROVIDER_PRIVATE_KEY=

# --- QuickBooks (optional) ---
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox         # sandbox | production

# --- External services ---
ML_SERVICE_URL=http://ml-service:8000
WORKFLOW_ENGINE_URL=http://workflow-engine:3003
MIL_SERVICE_URL=http://mil:3010
MIL_WRAPPER_ENABLED=false

# --- Estimate service ---
ESTIMATE_DEFAULT_CURRENCY=USD
ESTIMATE_ENABLE_CACHING=true
ESTIMATE_CACHE_TTL_HOURS=24

# --- Admin bootstrap (non-production convenience; keep disabled in prod) ---
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
