  documentUrl    String?
  status         String    @default("PENDING") // PENDING, VERIFIED, EXPIRED
  expirationDate DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vendorId, status])
}

model TenantInsurancePolicy {
  id             String   @id @default(uuid()) @db.Uuid
  leaseId        String   @db.Uuid
  lease          Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  provider       String?
  policyNumber   String?
  coverageAmount Float?
  startDate      DateTime
  endDate        DateTime
  status         String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, FORCE_PLACED
  documentUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([leaseId, status])
  @@index([endDate])
}

model OwnerDraw {
  id                  String         @id @default(uuid()) @db.Uuid
  ownerStatementId    String         @db.Uuid
  ownerStatement      OwnerStatement @relation(fields: [ownerStatementId], references: [id])
  ledgerTransactionId String?        @db.Uuid
  amountCents         Int
  status              String         @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  drawDate            DateTime?
  bankAccountId       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([ownerStatementId])
  @@index([status])
}

model MasterUtilityBill {
  id               String              @id @default(uuid()) @db.Uuid
  propertyId       String              @db.Uuid
  property         Property            @relation(fields: [propertyId], references: [id])
  utilityType      String // WATER, ELECTRICITY, GAS, TRASH
  billingPeriod    String // e.g. "2023-10"
  totalAmountCents Int
  dueDate          DateTime
  status           String              @default("RECEIVED") // RECEIVED, ALLOCATED, PAID
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  allocations      UtilityAllocation[]

  @@unique([propertyId, utilityType, billingPeriod])
}

model UtilityAllocation {
  id                   String            @id @default(uuid()) @db.Uuid
  masterBillId         String            @db.Uuid
  masterBill           MasterUtilityBill @relation(fields: [masterBillId], references: [id], onDelete: Cascade)
  leaseId              String            @db.Uuid
  lease                Lease             @relation(fields: [leaseId], references: [id])
  allocatedAmountCents Int
  allocationMethod     String // SQFT, OCCUPANCY, EVEN_SPLIT
  chargeId             String?           @db.Uuid // Optional link to ManualCharge or Invoice
  createdAt            DateTime          @default(now())

  @@index([masterBillId])
  @@index([leaseId])
}

// --- Phase 2: Operations & Orchestration ---

model SmartDevice {
  id           String    @id @default(uuid()) @db.Uuid
  propertyId   String    @db.Uuid
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId       String?   @db.Uuid
  unit         Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  provider     String // e.g., SMARTRENT, BRIVO
  deviceType   String // LOCK, THERMOSTAT, SENSOR
  providerId   String    @unique
  name         String
  batteryLevel Int?
  isOnline     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accessCodes AccessCode[]

  @@index([propertyId, deviceType])
  @@index([unitId])
}

model AccessCode {
  id         String      @id @default(uuid()) @db.Uuid
  deviceId   String      @db.Uuid
  device     SmartDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  propertyId String      @db.Uuid
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId     String?     @db.Uuid
  unit       Unit?       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  code       String
  name       String // e.g., "Maintenance - Plumber" or "Self-Guided Tour"
  status     String      @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  startsAt   DateTime?
  endsAt     DateTime?
  usageCount Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([deviceId, status])
  @@index([propertyId])
}

model OmnichannelThread {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  status    String   @default("OPEN") // OPEN, SNOOZED, RESOLVED
  title     String? // auto-generated or manual summary
  priority  String   @default("NORMAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages CommunicationLog[]

  @@index([tenantId, status])
}

