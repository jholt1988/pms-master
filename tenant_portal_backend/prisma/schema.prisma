enum BidStatus {
  OPEN
  BID_RECEIVED
  AWARDED
  REJECTED
  COMPLETED
}

enum ForecastUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ForecastStatus {
  PROJECTED
  APPROVED
  IN_PROGRESS
  COMPLETED
}

enum AbstractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  REVIEW_NEEDED
  FAILED
}

model ContractorBid {
  id                   String    @id @default(uuid()) @db.Uuid
  propertyId           String    @db.Uuid
  property             Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  maintenanceRequestId String?   @db.Uuid
  vendorId             String?   @db.Uuid
  scope                String
  bidAmountCents       Int?
  aiScore              Float?
  aiRationale          String?
  status               BidStatus @default(OPEN)
  dueDate              DateTime?
  awardedAt            DateTime?
  vendorName           String?
  vendorEmail          String?
  responseNotes        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([propertyId, status])
  @@index([vendorId])
  @@index([maintenanceRequestId])
}

model CapExForecast {
  id                 String          @id @default(uuid()) @db.Uuid
  propertyId         String          @db.Uuid
  property           Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  organizationId     String          @db.Uuid
  category           String
  description        String
  estimatedCostCents Int
  confidenceScore    Float?
  projectedYear      Int
  urgency            ForecastUrgency @default(MEDIUM)
  aiRationale        String?
  status             ForecastStatus  @default(PROJECTED)
  approvedBudget     Int?
  actualCostCents    Int?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([propertyId, projectedYear])
  @@index([organizationId, status])
  @@index([urgency])
}

model LeaseAbstraction {
  id              String            @id @default(uuid()) @db.Uuid
  leaseId         String            @db.Uuid
  lease           Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  documentId      String?           @db.Uuid
  extractedData   Json?
  keyDates        Json?
  financialTerms  Json?
  clauses         Json?
  aiConfidence    Float?
  status          AbstractionStatus @default(PENDING)
  reviewedById    String?           @db.Uuid
  reviewedAt      DateTime?
  processingError String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([leaseId])
  @@index([status])
}

// =============================================
// TENANT MANAGEMENT
// =============================================

enum TenantRelationshipStatus {
  APPLICANT
  APPROVED
  ONBOARDING
  ACTIVE
  DELINQUENT
  AT_RISK
  RENEWAL_DUE
  NOTICE_SENT
  MOVING_OUT
  TRANSFERRED
  FORMER
  BLOCKED
}

enum TenantHealthClassification {
  STABLE
  WATCH
  AT_RISK
  HIGH_TOUCH
}

model TenantProfile {
  id                 String                     @id @default(uuid()) @db.Uuid
  userId             String                     @unique @db.Uuid
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredName      String?
  relationshipStatus TenantRelationshipStatus   @default(ACTIVE)
  healthClass        TenantHealthClassification @default(STABLE)
  tags               String[]                   @default([])
  pets               Json?
  vehicles           Json?
  idVerified         Boolean                    @default(false)
  idVerifiedAt       DateTime?
  moveInDate         DateTime?
  moveOutDate        DateTime?
  notes              String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  householdMembers HouseholdMember[]
  statusHistory    TenantStatusHistory[]
  violations       Violation[]

  @@index([relationshipStatus])
  @@index([healthClass])
}

model HouseholdMember {
  id              String        @id @default(uuid()) @db.Uuid
  tenantProfileId String        @db.Uuid
  tenantProfile   TenantProfile @relation(fields: [tenantProfileId], references: [id], onDelete: Cascade)
  name            String
  relationship    String
  phone           String?
  email           String?
  isEmergency     Boolean       @default(false)
  isOnLease       Boolean       @default(false)
  dateOfBirth     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantProfileId])
}

model TenantStatusHistory {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantProfileId String                    @db.Uuid
  tenantProfile   TenantProfile             @relation(fields: [tenantProfileId], references: [id], onDelete: Cascade)
  fromStatus      TenantRelationshipStatus?
  toStatus        TenantRelationshipStatus
  reason          String?
  changedById     String?                   @db.Uuid
  metadata        Json?
  createdAt       DateTime                  @default(now())

  @@index([tenantProfileId, createdAt])
}

model Violation {
  id              String        @id @default(uuid()) @db.Uuid
  tenantProfileId String        @db.Uuid
  tenantProfile   TenantProfile @relation(fields: [tenantProfileId], references: [id], onDelete: Cascade)
  type            String
  description     String
  severity        String        @default("WARNING")
  isResolved      Boolean       @default(false)
  resolvedAt      DateTime?
  resolvedById    String?       @db.Uuid
  resolvedNotes   String?
  issuedAt        DateTime      @default(now())
  issuedById      String?       @db.Uuid
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantProfileId, isResolved])
  @@index([type])
}

model TelemetryEvent {
  id        Int      @id @default(autoincrement())
  eventName String   @map("event_name") @db.VarChar(100)
  userId    String?  @map("user_id") @db.VarChar(100)
  orgId     String?  @map("org_id") @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  domain    String?  @db.VarChar(50)
  outcome   String?  @db.VarChar(20)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("telemetry_events")
}

model Decision {
  id         Int      @id @default(autoincrement())
  domain     String   @db.VarChar(50)
  type       String   @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(100)
  title      String   @db.VarChar(255)
  priority   Int      @default(50)
  urgency    String   @db.VarChar(50)
  context    Json?
  resolved   Boolean  @default(false)
  resolvedAt DateTime? @map("resolved_at")
  resolution String?
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([domain, resolved])
  @@index([entityId])
  @@map("decisions")
}

model Notice {
  id         Int      @id @default(autoincrement())
  paymentId  Int      @map("payment_id")
  noticeType String   @map("notice_type") @db.VarChar(50)
  message    String
  sentAt     DateTime @default(now()) @map("sent_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("notices")
}
