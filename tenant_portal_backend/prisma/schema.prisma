generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// --- Multi-tenant foundation (PM company / landlord account) ---


model User {
  username                        String                      @unique
  password                        String
  role                            Role                        @default(TENANT)
  failedLoginAttempts             Int                         @default(0)
  lastLoginAt                     DateTime?
  lockoutUntil                    DateTime?
  mfaEnabled                      Boolean                     @default(false)
  mfaSecret                       String?
  mfaTempSecret                   String?
  passwordUpdatedAt               DateTime                    @default(now())
  stripeCustomerId                String?                     @unique
  phoneNumber                     String?
  driverLicenseImage              String?
  driverLicenseNumber             String?
  email                           String?                     @unique
  firstName                       String?
  lastName                        String?
  socialSecurityImage             String?
  socialSecurityNumber            String?
  id                              String                      @id @default(uuid()) @db.Uuid
  actionIntents                   ActionIntent[]
  agentRunsInitiated              AgentRun[]                  @relation("AgentRunInitiatedBy")
  agentRunsAsTenant               AgentRun[]                  @relation("AgentRunTenant")
  resolvedAnomalies               AnomalyLog[]                @relation("AnomalyResolver")
  lifecycleEvents                 ApplicationLifecycleEvent[] @relation("LifecycleEventPerformers")
  approvalTaskCreatedBy           ApprovalTask[]              @relation("ApprovalCreatedBy")
  approvalTaskDecidedBy           ApprovalTask[]              @relation("ApprovalDecidedBy")
  approvalTasks                   ApprovalTask[]              @relation("ApprovalTenant")
  auditLogs                       AuditLog[]
  bankTransactionsRecorded        BankTransaction[]           @relation("BankTransactionRecordedBy")
  bookkeepingTransactionsReviewed BookkeepingTransaction[]    @relation("BookkeepingTxReviewer")
  bulkMessageBatches              BulkMessageBatch[]
  bulkMessageRecipients           BulkMessageRecipient[]
  createdCommunicationLogs        CommunicationLog[]          @relation("CommunicationLogCreatedBy")
  tenantCommunicationLogs         CommunicationLog[]          @relation("CommunicationLogTenant")
  conversations                   ConversationParticipant[]
  decisionRecords                 DecisionRecord[]
  documents                       Document[]
  createdEsignEnvelopes           EsignEnvelope[]             @relation("EnvelopeCreator")
  esignParticipantRecords         EsignParticipant[]          @relation("EsignParticipantUser")
  expenses                        Expense[]                   @relation("RecordedExpenses")
  feeScheduleVersionsCreated      FeeScheduleVersion[]        @relation("FeeScheduleVersionCreatedBy")
  checklistPhotos                 InspectionChecklistPhoto[]  @relation("ChecklistPhotoUploader")
  decidedInspectionRequests       InspectionRequest[]         @relation("InspectionRequestDecidedBy")
  inspectionRequests              InspectionRequest[]         @relation("InspectionRequestTenant")
  inspectionSignatures            InspectionSignature[]       @relation("InspectionSigner")
  journalEntriesCreated           JournalEntry[]              @relation("JournalEntryCreatedBy")
  journalEntriesPosted            JournalEntry[]              @relation("JournalEntryPostedBy")
  leadApplicationReviews          LeadApplication[]           @relation("LeadApplicationReviewers")
  lease                           Lease[]
  LeaseDocument                   LeaseDocument[]
  LeaseHistory                    LeaseHistory[]
  LeaseNotice                     LeaseNotice[]
  LeaseRenewalOffer               LeaseRenewalOffer[]
  MaintenanceNote                 MaintenanceNote[]
  MaintenancePhoto                MaintenancePhoto[]
  requests                        MaintenanceRequest[]
  MaintenanceRequestHistory       MaintenanceRequestHistory[]
  manualChargesCreated            ManualCharge[]              @relation("ManualChargeCreatedBy")
  manualCharges                   ManualCharge[]              @relation("ManualChargeTenant")
  manualPaymentsCreated           ManualPayment[]             @relation("ManualPaymentCreatedBy")
  manualPayments                  ManualPayment[]             @relation("ManualPaymentTenant")
  sentMessages                    Message[]                   @relation("sentMessages")
  messageTemplates                MessageTemplate[]
  notifications                   Notification[]
  notificationPreference          NotificationPreference?
  ownerStatementsApproved         OwnerStatement[]            @relation("OwnerStatementApprover")
  ownerStatementsReceived         OwnerStatement[]            @relation("OwnerStatementOwner")
  passwordResetTokens             PasswordResetToken[]
  payments                        Payment[]
  paymentMethods                  PaymentMethod[]
  reconciliationSessionsStarted   ReconciliationSession[]     @relation("ReconciliationStartedBy")
  reconciliationItemsResolved     ReconciliationSessionItem[] @relation("ReconciliationItemResolver")
  refreshTokens                   RefreshToken[]
  acceptedRecommendations         RentRecommendation[]        @relation("AcceptedRentRecommendations")
  rejectedRecommendations         RentRecommendation[]        @relation("RejectedRentRecommendations")
  rentalApplications              RentalApplication[]
  screenedApplications            RentalApplication[]         @relation("ScreenedApplications")
  applicationNotes                RentalApplicationNote[]
  approvedEstimates               RepairEstimate[]            @relation("ApprovedEstimates")
  generatedEstimates              RepairEstimate[]            @relation("GeneratedEstimates")
  savedPropertyFilters            SavedPropertyFilter[]
  scheduleEvents                  ScheduleEvent[]             @relation("ScheduleEventTenant")
  securityEvents                  SecurityEvent[]
  Technician                      Technician[]
  tenantProfile                   TenantProfile?
  toursConducted                  Tour[]                      @relation("TourConductedBy")
  transactionImportBatches        TransactionImportBatch[]    @relation("TransactionImportBy")
  createdInspections              UnitInspection[]            @relation("CreatedBy")
  inspections                     UnitInspection[]            @relation("Inspector")
  tenantInspections               UnitInspection[]            @relation("InspectionTenant")
  UnitInspectionPhoto             UnitInspectionPhoto[]
  organizations                   UserOrganization[]
  quickBooksConnections           QuickBooksConnection[]      @relation("UserQuickBooksConnections")
  sharedDocuments                 Document[]                  @relation("DocumentShares")

  @@index([email])
  @@index([role])
}

model Organization {
  id                          String                   @id @default(uuid()) @db.Uuid
  name                        String
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  stripeConnectedAccountId    String?                  @unique
  stripeOnboardingStatus      StripeOnboardingStatus   @default(NOT_STARTED)
  stripeChargesEnabled        Boolean                  @default(false)
  stripePayoutsEnabled        Boolean                  @default(false)
  stripeDetailsSubmitted      Boolean                  @default(false)
  stripeCapabilities          Json?
  stripeOnboardingCompletedAt DateTime?
  stripeLastOnboardingCheckAt DateTime?
  delinquencyDaysWeight       Float?
  delinquencyAmountWeight     Float?
  currency                    String?                  @default("USD")
  dateFormat                  String?                  @default("MM/DD/YYYY")
  lateFeeAmount               Float?                   @default(0)
  lateFeeEnabled              Boolean                  @default(false)
  lateFeeGraceDays            Int?                     @default(5)
  quickbooksConnected         Boolean                  @default(false)
  timezone                    String?                  @default("America/New_York")
  actionIntents               ActionIntent[]
  bookkeepingTransactions     BookkeepingTransaction[]
  chartOfAccounts             ChartOfAccount[]
  decisionRecords             DecisionRecord[]
  feeScheduleVersions         FeeScheduleVersion[]
  idempotencyRecords          IdempotencyRecord[]
  journalEntries              JournalEntry[]
  ledgerAccounts              LedgerAccount[]
  manualCharges               ManualCharge[]
  manualPayments              ManualPayment[]
  planCycles                  OrgPlanCycle[]
  ownerStatements             OwnerStatement[]
  paymentLedgerEntries        PaymentLedgerEntry[]
  pricingSnapshots            PricingSnapshot[]
  properties                  Property[]
  reconciliationSessions      ReconciliationSession[]
  stripeWebhookEvents         StripeWebhookEvent[]
  syndicationCredentials      SyndicationCredential[]
  technicians                 Technician[]
  users                       UserOrganization[]
  vendors                     Vendor[]
  quickBooksConnections       QuickBooksConnection[]
  quickBooksWebhookEvents     QuickBooksWebhookEvent[]
}

model UserOrganization {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           OrgRole      @default(MEMBER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model OrgPlanCycle {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @db.Uuid
  name                String
  startsAt            DateTime
  endsAt              DateTime
  status              OrgPlanCycleStatus  @default(DRAFT)
  activeFeeScheduleId String?             @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  activeFeeSchedule   FeeScheduleVersion? @relation("ActiveFeeSchedule", fields: [activeFeeScheduleId], references: [id])
  organization        Organization        @relation(fields: [organizationId], references: [id])
  snapshots           PricingSnapshot[]

  @@index([organizationId, status])
  @@index([startsAt, endsAt])
}

model FeeScheduleVersion {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  versionLabel     String
  effectiveAt      DateTime
  feeConfig        Json
  createdById      String?           @db.Uuid
  createdAt        DateTime          @default(now())
  createdBy        User?             @relation("FeeScheduleVersionCreatedBy", fields: [createdById], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  planCyclesActive OrgPlanCycle[]    @relation("ActiveFeeSchedule")
  snapshots        PricingSnapshot[]

  @@unique([organizationId, versionLabel])
  @@index([organizationId, effectiveAt])
}

model PricingSnapshot {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @db.Uuid
  planCycleId          String             @db.Uuid
  feeScheduleVersionId String             @db.Uuid
  snapshotType         String             @default("BILLING_PREVIEW")
  inputPayload         Json?
  computedFees         Json
  createdAt            DateTime           @default(now())
  feeScheduleVersion   FeeScheduleVersion @relation(fields: [feeScheduleVersionId], references: [id])
  organization         Organization       @relation(fields: [organizationId], references: [id])
  planCycle            OrgPlanCycle       @relation(fields: [planCycleId], references: [id])

  @@index([organizationId, createdAt])
  @@index([planCycleId, createdAt])
}

model Property {
  name                    String
  address                 String
  city                    String?
  state                   String?
  zipCode                 String?
  country                 String?                   @default("USA")
  latitude                Float?
  longitude               Float?
  propertyType            String?
  description             String?
  bedrooms                Float?
  bathrooms               Float?
  minRent                 Float?
  maxRent                 Float?
  tags                    String[]                  @default([])
  yearBuilt               Int?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  id                      String                    @id @default(uuid()) @db.Uuid
  organizationId          String                    @db.Uuid
  accessCodes             AccessCode[]
  agentRuns               AgentRun[]                @relation("AgentRunProperty")
  approvalTasks           ApprovalTask[]
  bankTransactions        BankTransaction[]         @relation("BankTransactionProperty")
  capExForecasts          CapExForecast[]
  communicationLogs       CommunicationLog[]        @relation("CommunicationLogProperty")
  contractorBids          ContractorBid[]
  Document                Document[]
  expenses                Expense[]
  inspectionRequests      InspectionRequest[]
  leadApplications        LeadApplication[]
  MaintenanceAsset        MaintenanceAsset[]
  MaintenanceRequest      MaintenanceRequest[]
  MaintenanceSlaPolicy    MaintenanceSlaPolicy[]
  manualCharges           ManualCharge[]
  manualPayments          ManualPayment[]
  masterUtilityBills      MasterUtilityBill[]
  policyAttorneyReferrals PolicyAttorneyReferral[]
  policyBundles           PolicyBundle[]
  policyMonthlyCloses     PolicyMonthlyClose[]
  policyRuleActionLogs    PolicyRuleActionLog[]
  policyRuleEvaluations   PolicyRuleEvaluation[]
  policyServiceProofs     PolicyServiceProof[]
  policyWorkflowEvents    PolicyWorkflowEvent[]
  organization            Organization              @relation(fields: [organizationId], references: [id])
  amenities               PropertyAmenity[]
  propertyInquiries       PropertyInquiry[]
  marketingProfile        PropertyMarketingProfile?
  photos                  PropertyPhoto[]
  rentalApplications      RentalApplication[]
  repairEstimates         RepairEstimate[]
  scheduleEvents          ScheduleEvent[]
  smartDevices            SmartDevice[]
  syndicationErrors       SyndicationErrorLog[]
  syndicationQueue        SyndicationQueue[]
  tours                   Tour[]
  units                   Unit[]
  UnitInspection          UnitInspection[]

  @@index([organizationId])
  @@index([city, state])
  @@index([propertyType])
  @@index([bedrooms])
  @@index([bathrooms])
  @@index([minRent])
}

model PropertyMarketingProfile {
  id                   Int                        @id @default(autoincrement())
  minRent              Float?
  maxRent              Float?
  availabilityStatus   PropertyAvailabilityStatus @default(AVAILABLE)
  availableOn          DateTime?
  marketingHeadline    String?
  marketingDescription String?
  rentRangeCurrency    String                     @default("USD")
  isSyndicationEnabled Boolean                    @default(true)
  lastSyncedAt         DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  propertyId           String                     @unique @db.Uuid
  property             Property                   @relation(fields: [propertyId], references: [id])
}

model PropertyPhoto {
  id           Int      @id @default(autoincrement())
  url          String
  caption      String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model Amenity {
  id          Int               @id @default(autoincrement())
  key         String            @unique
  label       String
  description String?
  category    String?
  properties  PropertyAmenity[]
}

model PropertyAmenity {
  id         Int      @id @default(autoincrement())
  amenityId  Int
  value      String?
  isFeatured Boolean  @default(false)
  propertyId String   @db.Uuid
  amenity    Amenity  @relation(fields: [amenityId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
}

model SavedPropertyFilter {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  filters     Json
  sortBy      String?
  sortOrder   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Unit {
  name                String
  unitNumber          String?
  bedrooms            Float?
  bathrooms           Float?
  squareFeet          Int?
  hasParking          Boolean              @default(false)
  hasLaundry          Boolean              @default(false)
  hasBalcony          Boolean              @default(false)
  hasAC               Boolean              @default(false)
  isFurnished         Boolean              @default(false)
  petsAllowed         Boolean              @default(false)
  propertyId          String               @db.Uuid
  id                  String               @id @default(uuid()) @db.Uuid
  status              UnitStatus           @default(VACANT)
  accessCodes         AccessCode[]
  agentRuns           AgentRun[]           @relation("AgentRunUnit")
  approvalTasks       ApprovalTask[]
  bankTransactions    BankTransaction[]    @relation("BankTransactionUnit")
  communicationLogs   CommunicationLog[]   @relation("CommunicationLogUnit")
  expenses            Expense[]
  inspectionRequests  InspectionRequest[]
  leadApplications    LeadApplication[]
  lease               Lease[]
  MaintenanceAsset    MaintenanceAsset[]
  MaintenanceRequest  MaintenanceRequest[]
  manualCharges       ManualCharge[]
  manualPayments      ManualPayment[]
  propertyInquiries   PropertyInquiry[]
  rentRecommendations RentRecommendation[]
  rentalApplications  RentalApplication[]
  repairEstimates     RepairEstimate[]
  scheduleEvents      ScheduleEvent[]
  smartDevices        SmartDevice[]
  tours               Tour[]
  property            Property             @relation(fields: [propertyId], references: [id])
  inspections         UnitInspection[]

  @@index([propertyId])
  @@index([status])
}

model SyndicationCredential {
  id             Int                @id @default(autoincrement())
  channel        SyndicationChannel
  config         Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organizationId String             @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, channel])
  @@index([organizationId])
}

model SyndicationQueue {
  id            Int                @id @default(autoincrement())
  channel       SyndicationChannel
  payload       Json?
  status        SyndicationStatus  @default(PENDING)
  retryCount    Int                @default(0)
  maxRetries    Int                @default(5)
  lastError     String?
  nextRunAt     DateTime?
  lastAttemptAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  propertyId    String             @db.Uuid
  property      Property           @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([channel])
  @@index([status])
}

model RentRecommendation {
  id                          String                   @id
  factors                     Json
  marketComparables           Json
  modelVersion                String?
  reasoning                   String?
  status                      RentRecommendationStatus @default(PENDING)
  generatedAt                 DateTime                 @default(now())
  acceptedAt                  DateTime?
  rejectedAt                  DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  acceptedById                String?                  @db.Uuid
  rejectedById                String?                  @db.Uuid
  unitId                      String                   @db.Uuid
  currentRentCents            Int
  recommendedRentCents        Int
  confidenceIntervalLowCents  Int
  confidenceIntervalHighCents Int
  acceptedBy                  User?                    @relation("AcceptedRentRecommendations", fields: [acceptedById], references: [id])
  rejectedBy                  User?                    @relation("RejectedRentRecommendations", fields: [rejectedById], references: [id])
  unit                        Unit                     @relation(fields: [unitId], references: [id])

  @@index([unitId])
  @@index([status])
  @@index([acceptedById])
  @@index([rejectedById])
}

model SyndicationErrorLog {
  id         Int                @id @default(autoincrement())
  channel    SyndicationChannel
  error      String
  context    Json?
  occurredAt DateTime           @default(now())
  propertyId String             @db.Uuid
  property   Property           @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([channel])
}

model Lease {
  startDate                 DateTime
  endDate                   DateTime
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  autoRenew                 Boolean                   @default(false)
  autoRenewLeadDays         Int?
  billingAlignment          BillingAlignment          @default(FULL_CYCLE)
  depositDisposition        DepositDisposition?
  depositHeldAt             DateTime?
  depositReturnedAt         DateTime?
  moveInAt                  DateTime?
  moveOutAt                 DateTime?
  noticePeriodDays          Int                       @default(30)
  renewalAcceptedAt         DateTime?
  renewalDueAt              DateTime?
  renewalOfferedAt          DateTime?
  rentEscalationEffectiveAt DateTime?
  rentEscalationPercent     Float?
  status                    LeaseStatus               @default(DRAFT)
  terminationEffectiveAt    DateTime?
  terminationReason         String?
  terminationRequestedBy    LeaseTerminationParty?
  tenantId                  String                    @db.Uuid
  id                        String                    @id @default(uuid()) @db.Uuid
  unitId                    String                    @db.Uuid
  version                   Int                       @default(0)
  userId                    String?                   @db.Uuid
  rentAmountCents           Int
  depositAmountCents        Int                       @default(0)
  currentBalanceCents       Int                       @default(0)
  depositAmount             Int?
  agentRuns                 AgentRun[]                @relation("AgentRunLease")
  approvalTasks             ApprovalTask[]
  autopayEnrollment         AutopayEnrollment?
  communicationLogs         CommunicationLog[]        @relation("CommunicationLogLease")
  generalDocuments          Document[]
  esignEnvelopes            EsignEnvelope[]
  inspectionRequests        InspectionRequest[]
  invoices                  Invoice[]
  tenant                    Tenant                    @relation(fields: [tenantId], references: [id])
  unit                      Unit                      @relation(fields: [unitId], references: [id])
  User                      User?                     @relation(fields: [userId], references: [id])
  leaseAbstractions         LeaseAbstraction[]
  documents                 LeaseDocument[]
  history                   LeaseHistory[]
  notices                   LeaseNotice[]
  renewalOffers             LeaseRenewalOffer[]
  ledgerAccounts            LedgerAccount[]
  maintenanceRequests       MaintenanceRequest[]
  manualCharges             ManualCharge[]
  manualPayments            ManualPayment[]
  payments                  Payment[]
  recurringSchedule         RecurringInvoiceSchedule?
  originatingApplications   RentalApplication[]
  insurancePolicies         TenantInsurancePolicy[]
  inspections               UnitInspection[]
  utilityAllocations        UtilityAllocation[]

  @@index([status])
  @@index([endDate])
}

model MaintenanceRequest {
  title             String
  description       String
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  status            Status                       @default(PENDING)
  acknowledgedAt    DateTime?
  assetId           Int?
  assigneeId        Int?
  completedAt       DateTime?
  dueAt             DateTime?
  priority          MaintenancePriority          @default(MEDIUM)
  responseDueAt     DateTime?
  slaPolicyId       Int?
  authorId          String                       @db.Uuid
  propertyId        String?                      @db.Uuid
  id                String                       @id @default(uuid()) @db.Uuid
  leaseId           String?                      @db.Uuid
  unitId            String?                      @db.Uuid
  version           Int                          @default(0)
  assignedAt        DateTime?
  vendorId          String?                      @db.Uuid
  agentRuns         AgentRun[]                   @relation("AgentRunRequest")
  approvalTasks     ApprovalTask[]
  communicationLogs CommunicationLog[]           @relation("CommunicationLogRequest")
  notes             MaintenanceNote[]
  photos            MaintenancePhoto[]
  asset             MaintenanceAsset?            @relation("AssetRequests", fields: [assetId], references: [id])
  assignee          Technician?                  @relation("TechnicianAssignments", fields: [assigneeId], references: [id])
  author            User                         @relation(fields: [authorId], references: [id])
  lease             Lease?                       @relation(fields: [leaseId], references: [id])
  property          Property?                    @relation(fields: [propertyId], references: [id])
  slaPolicy         MaintenanceSlaPolicy?        @relation(fields: [slaPolicyId], references: [id])
  unit              Unit?                        @relation(fields: [unitId], references: [id])
  Vendor            Vendor?                      @relation(fields: [vendorId], references: [id])
  documents         MaintenanceRequestDocument[] @relation("MaintenanceRequestDocuments")
  history           MaintenanceRequestHistory[]
  repairEstimates   RepairEstimate[]

  @@index([authorId])
  @@index([propertyId])
  @@index([unitId])
  @@index([assigneeId])
  @@index([leaseId])
  @@index([status])
}

model MaintenanceAsset {
  id                Int                      @id @default(autoincrement())
  name              String
  category          MaintenanceAssetCategory
  manufacturer      String?
  model             String?
  serialNumber      String?
  installDate       DateTime?
  warrantyExpiresAt DateTime?
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  propertyId        String                   @db.Uuid
  unitId            String?                  @db.Uuid
  property          Property                 @relation(fields: [propertyId], references: [id])
  unit              Unit?                    @relation(fields: [unitId], references: [id])
  requests          MaintenanceRequest[]     @relation("AssetRequests")

  @@unique([propertyId, unitId, name], name: "MaintenanceAsset_property_unit_name_key")
  @@index([propertyId])
  @@index([unitId])
}

model Technician {
  id               Int                         @id @default(autoincrement())
  name             String
  phone            String?
  email            String?
  role             TechnicianRole              @default(IN_HOUSE)
  active           Boolean                     @default(true)
  notes            String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  emergencyService Boolean                     @default(false)
  insuranceOnFile  Boolean                     @default(false)
  preferredContact PreferredContactMethod      @default(EMAIL)
  serviceZips      String[]                    @default([])
  trades           String[]                    @default([])
  userId           String?                     @db.Uuid
  organizationId   String                      @db.Uuid
  assignments      MaintenanceRequest[]        @relation("TechnicianAssignments")
  historyFrom      MaintenanceRequestHistory[] @relation("HistoryFromAssignee")
  historyTo        MaintenanceRequestHistory[] @relation("HistoryToAssignee")
  organization     Organization                @relation(fields: [organizationId], references: [id])
  user             User?                       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([role, active])
  @@index([organizationId])
}

model MaintenanceSlaPolicy {
  id                    Int                  @id @default(autoincrement())
  name                  String?
  priority              MaintenancePriority
  responseTimeMinutes   Int?
  resolutionTimeMinutes Int
  active                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  propertyId            String?              @db.Uuid
  requests              MaintenanceRequest[]
  property              Property?            @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, priority], name: "MaintenanceSlaPolicy_property_priority_key")
  @@index([priority])
}

model MaintenanceRequestHistory {
  id             Int                @id @default(autoincrement())
  fromStatus     Status?
  toStatus       Status?
  fromAssigneeId Int?
  toAssigneeId   Int?
  note           String?
  createdAt      DateTime           @default(now())
  changedById    String?            @db.Uuid
  requestId      String             @db.Uuid
  changedBy      User?              @relation(fields: [changedById], references: [id])
  fromAssignee   Technician?        @relation("HistoryFromAssignee", fields: [fromAssigneeId], references: [id])
  request        MaintenanceRequest @relation(fields: [requestId], references: [id])
  toAssignee     Technician?        @relation("HistoryToAssignee", fields: [toAssigneeId], references: [id])

  @@index([requestId, createdAt])
}

model MaintenanceNote {
  id        Int                @id @default(autoincrement())
  body      String
  createdAt DateTime           @default(now())
  authorId  String             @db.Uuid
  requestId String             @db.Uuid
  author    User               @relation(fields: [authorId], references: [id])
  request   MaintenanceRequest @relation(fields: [requestId], references: [id])

  @@index([requestId, createdAt])
}

model MaintenancePhoto {
  id           Int                @id @default(autoincrement())
  url          String
  caption      String?
  createdAt    DateTime           @default(now())
  uploadedById String?            @db.Uuid
  requestId    String             @db.Uuid
  request      MaintenanceRequest @relation(fields: [requestId], references: [id])
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id])

  @@index([requestId])
}

