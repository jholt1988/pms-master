  termsAcceptedAt       DateTime?
  termsVersion          String?
  privacyAcceptedAt     DateTime?
  privacyVersion        String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@index([leadId])
  @@index([propertyId])
  @@index([status, followUpDueAt])
