// This is your Materialized View for the keyring-os Co-Pilot
model FeedItem {
  id     String @id @default(uuid())
  domain String // 'leasing', 'maintenance', 'payments', 'screening'
  type   String // e.g., 'rent_delinquent', 'lease_expiring'

  // The heavily calculated metric
  priorityScore Float

  // Display Context for Next.js
  title    String
  summary  String
  evidence Json // e.g., { "daysOverdue": 15, "amount": 1200 }
  actions  Json // e.g., [{ "label": "Start Eviction", "intent": "evict" }]

  // Access Control
  roleAccess String[] // e.g., ['property_manager', 'admin']
  tenantId   String? // Optional relation if signal is tenant-specific
  propertyId String? // Optional relation if signal is property-specific

  // State
  isDismissed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleAccess])
  @@index([priorityScore(sort: Desc)]) // Crucial for sub-50ms reads
  @@index([propertyId])
}

