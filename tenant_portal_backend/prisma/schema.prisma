  input        Json
  output       Json?
  ok           Boolean @default(false)
  errorCode    String?
  errorMessage String?
  latencyMs    Int?

  createdAt DateTime @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId, toolName])
  @@index([toolName, createdAt])
}

